server {
    # PORT llega por variable de entorno: en compose no está seteada (usa el
    # default de 80 del entrypoint), en Render es el puerto que el proveedor
    # le asigna al servicio — ahí es donde manda el tráfico, así que nginx
    # tiene que escuchar exactamente ahí, no en un 80 fijo que nadie usa.
    listen ${PORT};

    location /api/ {
        # BACKEND_URL llega por variable de entorno y se resuelve recién al
        # arrancar el contenedor (docker-entrypoint.sh la sustituye con
        # envsubst): en compose es el nombre del servicio, en Render es la
        # URL pública de la api de ESE entorno.
        proxy_pass ${BACKEND_URL};
        # Sin "Host $host" acá a propósito: Render enruta sus servicios por el
        # header Host, y $host es el dominio del FRONT. Si lo forzáramos,
        # nginx le llegaría a la api con el Host del front puesto, Render lo
        # malinterpretaría como un pedido PARA el front y lo rebotaría de
        # vuelta -> loop infinito (508 Loop Detected). Sin esta línea, nginx
        # usa su default ($proxy_host, el host de BACKEND_URL), que es lo que
        # hace falta para que Render enrute al servicio correcto.
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_ssl_server_name on;
    }

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
